    "3a752b8b-e6e3-4579-800b-8d6b4734e922": {
      "filters": null,
      "name": "The middle valley, before and after",
      "parameters": {
        "bearing": null,
        "content": {
          "attachments": {},
          "contentMode": "markdown",
          "image": "",
          "imageCaption": "",
          "markdown": "**Syabru Besi: the same six kilometre square, before the flood and after it.**\n\n![Syabru Besi, before and after](https://raw.githubusercontent.com/arjxn-py/nepal-flood-26-aug/main/data/nepal-flood-2026-review/fig-before-after-orange.png)\n\nThe river was already wide here. It came out wider still, and pale with new sand.\nIt took the fields and the edge of the road. It did not take the whole valley\nfloor.\n",
          "paneAlignment": "start",
          "panelWidth": "52%"
        },
        "enableIdentify": false,
        "extent": [
          9499994.212348886,
          3269944.0125006046,
