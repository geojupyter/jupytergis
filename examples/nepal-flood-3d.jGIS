    "5d2d1ef5-989b-4195-959d-b05983d12c4d": {
      "filters": null,
      "name": "About 09:00, Timure",
      "parameters": {
        "bearing": -146.0,
        "content": {
          "attachments": {},
          "contentMode": "map",
          "image": "",
          "imageCaption": "",
          "markdown": "**About 09:00. The water reaches Timure, 14 km down.**\n\nICIMOD says the Bhote Koshi began rising around 9:00. This story reads that as the water reaching Timure, 23 minutes after the slope gave way.\n\n**On the map:** the blue line is where the water had got to by then.\n",
          "paneAlignment": "start",
          "panelWidth": "30rem"
        },
        "enableIdentify": false,
        "extent": [
