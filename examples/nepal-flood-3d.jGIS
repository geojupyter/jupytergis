    "de07256c-4085-4ce9-92f4-192233f9fceb": {
      "filters": null,
      "name": "The open valley, before and after",
      "parameters": {
        "bearing": null,
        "content": {
          "attachments": {},
          "contentMode": "markdown",
          "image": "",
          "imageCaption": "",
          "markdown": "**Below Bidur: the same six kilometre square, before the flood and after it.**\n\n![below Bidur, before and after](https://raw.githubusercontent.com/arjxn-py/nepal-flood-26-aug/main/data/nepal-flood-2026-review/fig-before-after-yellow.png)\n\nHere the change is small: a wider, paler channel and more sand. This is the same\nflood that destroyed the gorge. Here the valley was wide enough to hold it.\n",
          "paneAlignment": "start",
          "panelWidth": "52%"
        },
        "enableIdentify": false,
        "extent": [
          9473656.0208272,
          3231334.4312644713,
          9473656.0208272,
          3231334.4312644713
