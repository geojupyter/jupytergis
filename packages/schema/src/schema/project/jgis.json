{
  "type": "object",
  "title": "IJGISContent",
  "required": ["layers", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "default": "0.6.0"
    },
    "layers": {
      "$ref": "#/definitions/jGISLayers"
    },
    "sources": {
      "$ref": "#/definitions/jGISSources"
    },
    "layerTree": {
      "$ref": "#/definitions/jGISLayerTree"
    },
    "options": {
      "$ref": "#/definitions/jGISOptions"
    },
    "stories": {
      "$ref": "#/definitions/jGISStoryMap"
    },
    "viewState": {
      "$ref": "#/definitions/jGISViewState"
    },
    "annotations": {
      "$ref": "#/definitions/jGISAnnotations"
    },
    "presets": {
      "$ref": "#/definitions/jGISDrawCustomAttributePresets"
    },
    "metadata": {
      "$ref": "#/definitions/jGISMetadata"
    }
  },
  "definitions": {
    "layerType": {
      "type": "string",
      "enum": [
        "RasterLayer",
        "VectorLayer",
        "VectorTileLayer",
        "HillshadeLayer",
        "GeoTiffLayer",
        "GeoZarrLayer",
        "ImageLayer",
        "StacLayer",
        "StorySegmentLayer",
        "OpenEOTileLayer"
      ]
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "RasterSource",
        "WmsTileSource",
        "VectorTileSource",
        "GeoJSONSource",
        "RasterDemSource",
        "ImageSource",
        "ShapefileSource",
        "GeoTiffSource",
        "GeoZarrSource",
        "GeoPackageVectorSource",
        "GeoPackageRasterSource",
        "GeoParquetSource",
        "MarkerSource",
        "OpenEOTileSource"
      ]
    },
    "jGISLayer": {
      "title": "IJGISLayer",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "visible"],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/layerType"
        },
        "visible": {
          "type": "boolean",
          "default": true
        },
        "parameters": {
          "type": "object"
        },
        "filters": {
          "$ref": "#/definitions/jGISFilter"
        }
      }
    },
    "jGISSource": {
      "title": "IJGISSource",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/sourceType"
        },
        "parameters": {
          "type": "object"
        },
        "metadata": {
          "$ref": "#/definitions/jGISSourceMetadata"
        }
      }
    },
    "jGISLayerGroup": {
      "title": "IJGISLayerGroup",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "layers"],
      "properties": {
        "name": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/jGISLayerItem"
          }
        },
        "visible": {
          "type": "boolean",
          "default": true
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "jGISLayerItem": {
      "title": "IJGISLayerItem",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/jGISLayerGroup"
        }
      ]
    },
    "jGISStoryMap": {
      "title": "IJGISStoryMap",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string",
          "title": "Title",
          "description": "The title of the story map"
        },
        "storyType": {
          "type": "string",
          "title": "Story Type",
          "enum": ["guided", "Vertical Scroll"],
          "description": "The type of story map"
        },
        "storySegments": {
          "type": "array",
          "default": [],
          "description": "Array of story segments for the story map",
          "items": {
            "type": "string"
          }
        },
        "showGradient": {
          "type": "boolean",
          "title": "Use gradient background",
          "description": "Toggle the gradient background in presentation mode.",
          "default": true
        },
        "markdownSegmentGap": {
          "type": "boolean",
          "title": "Gap between markdown segments",
          "description": "Inserts a full-stage gap between consecutive markdown segments in vertical scroll stories.",
          "default": false
        },
        "markdownSegmentOpacity": {
          "type": "number",
          "title": "Markdown segment opacity",
          "description": "Opacity of markdown segment backgrounds in vertical scroll stories.",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "storyPanelOpacity": {
          "type": "number",
          "title": "Story panel opacity",
          "description": "Opacity of story panel backgrounds over the map (0–1). Text stays fully opaque.",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "presentationBgColor": {
          "type": "string",
          "title": "Presentation Background Color",
          "description": "The background color of the story map"
        },
        "presentationTextColor": {
          "type": "string",
          "title": "Presentation Text Color",
          "description": "The text color of the story map"
        },
        "overlayContentWidth": {
          "type": "string",
          "title": "Overlay content width",
          "description": "CSS width for vertical-scroll markdown overlay content.",
          "default": "100%"
        }
      }
    },
    "jGISLayers": {
      "title": "IJGISLayers",
      "type": "object",
      "default": {},
      "additionalProperties": {
        "$ref": "#/definitions/jGISLayer"
      }
    },
    "jGISSources": {
      "title": "IJGISSources",
      "type": "object",
      "default": {},
      "additionalProperties": {
        "$ref": "#/definitions/jGISSource"
      }
    },
    "jGISLayerTree": {
      "title": "IJGISLayerTree",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/definitions/jGISLayerItem"
      }
    },
    "jGISViewState": {
      "title": "IJGISViewState",
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extent": {
            "type": "array",
            "items": { "type": "number" }
          },
          "zoom": {
            "type": "number"
          },
          "projection": {
            "type": "string"
          }
        },
        "required": ["extent"]
      }
    },
    "jGISOptions": {
      "title": "IJGISOptions",
      "type": "object",
      "default": {},
      "required": [],
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "default": 0
        },
        "longitude": {
          "type": "number",
          "default": 0
        },
        "zoom": {
          "type": "number",
          "default": 0
        },
        "bearing": {
          "type": "number",
          "default": 0
        },
        "pitch": {
          "type": "number",
          "default": 0
        },
        "extent": {
          "type": "array",
          "default": null,
          "items": {
            "type": "number"
          }
        },
        "projection": {
          "type": "string",
          "default": "EPSG:3857"
        },
        "useExtent": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "jGISFilterItem": {
      "title": "IJGISFilterItem",
      "type": "object",
      "default": {},
      "required": ["operator", "feature", "value"],
      "additionalProperties": false,
      "properties": {
        "operator": {
          "type": "string",
          "enum": ["==", "!=", ">", "<", ">=", "<=", "between"],
          "default": "=="
        },
        "feature": {
          "type": "string",
          "default": ""
        },
        "value": {
          "type": ["string", "number"]
        },
        "betweenMin": {
          "type": ["number"]
        },
        "betweenMax": {
          "type": ["number"]
        }
      }
    },
    "jGISFilter": {
      "title": "IJGISFilter",
      "type": "object",
      "required": ["logicalOp", "appliedFilters"],
      "additionalProperties": false,
      "properties": {
        "logicalOp": {
          "type": "string",
          "default": "all"
        },
        "appliedFilters": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/jGISFilterItem"
          }
        }
      }
    },
    "jGISAnnotationContent": {
      "title": "IJGISAnnotationContent",
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string"
        },
        "user": {
          "type": "object"
        }
      }
    },
    "jGISAnnotation": {
      "title": "IJGISAnnotation",
      "type": "object",
      "required": ["label", "position", "zoom", "contents", "parent", "open"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "zoom": {
          "type": "number"
        },
        "contents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/jGISAnnotationContent"
          }
        },
        "parent": {
          "type": "string"
        },
        "open": {
          "type": "boolean"
        }
      }
    },
    "jGISAnnotations": {
      "title": "IJGISAnnotations",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/jGISAnnotation"
      }
    },
    "jGISDrawCustomAttribute": {
      "title": "IDrawCustomAttribute",
      "type": "object",
      "required": ["key", "value"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "jGISDrawCustomAttributePreset": {
      "title": "IDrawCustomAttributePreset",
      "type": "array",
      "items": {
        "$ref": "#/definitions/jGISDrawCustomAttribute"
      }
    },
    "jGISDrawCustomAttributePresets": {
      "title": "IDrawCustomAttributePresets",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/jGISDrawCustomAttributePreset"
      }
    },
    "jGISMetadata": {
      "title": "IJGISMetadata",
      "type": "object",
      "default": {},
      "additionalProperties": { "type": "string" }
    },
    "jGISMetadataField": {
      "title": "IJGISMetadataField",
      "description": "A label/value row that does not fit any of the structured sections.",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "mono": {
          "type": "boolean",
          "description": "Render the value in a monospace font, for proj strings, WKT and URLs."
        },
        "href": {
          "type": "string",
          "description": "Render the value as an external link pointing at this URL."
        }
      }
    },
    "jGISCrsMetadata": {
      "title": "IJGISCrsMetadata",
      "description": "The coordinate reference system the data is stored in. Every field is optional: most formats only report some of this.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "Normalized authority code, e.g. `EPSG:26915`."
        },
        "name": {
          "type": "string",
          "description": "Human readable name, e.g. `NAD83 / UTM zone 15N`."
        },
        "proj4": {
          "type": "string",
          "description": "proj4 definition string."
        },
        "wkt": {
          "type": "string",
          "description": "Well-known text, only when the file itself carries it."
        },
        "units": {
          "type": "string",
          "description": "Linear/angular unit of the CRS, e.g. `m` or `degrees`."
        }
      }
    },
    "jGISExtentMetadata": {
      "title": "IJGISExtentMetadata",
      "description": "The bounding box of the data, as `[minX, minY, maxX, maxY]`.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Extent in the data's own CRS."
        },
        "nativeCrs": {
          "type": "string",
          "description": "The CRS `native` is expressed in."
        },
        "wgs84": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Extent in EPSG:4326, for readers who think in latitude/longitude."
        },
        "approximate": {
          "type": "boolean",
          "description": "True when this is the extent the layer occupies on the map rather than one read from the file itself."
        }
      }
    },
    "jGISBandMetadata": {
      "title": "IJGISBandMetadata",
      "description": "A single band of a raster.",
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "name"],
      "properties": {
        "band": { "type": "number", "description": "1-based band index." },
        "name": { "type": "string" },
        "dataType": { "type": "string" },
        "colorInterpretation": { "type": "string" },
        "noData": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      }
    },
    "jGISPyramidLevel": {
      "title": "IJGISPyramidLevel",
      "description": "One level of an internal tile pyramid (a GeoTIFF overview, a Zarr multiscale level).",
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {
          "type": "number",
          "description": "0 is the full resolution image."
        },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "scale": {
          "type": "number",
          "description": "Downsampling factor relative to the full resolution image."
        },
        "name": {
          "type": "string",
          "description": "Free-form label, used by formats that name their levels."
        }
      }
    },
    "jGISPyramidMetadata": {
      "title": "IJGISPyramidMetadata",
      "description": "How the data is tiled and pyramided.",
      "type": "object",
      "additionalProperties": false,
      "required": ["levels"],
      "properties": {
        "levels": {
          "type": "array",
          "items": { "$ref": "#/definitions/jGISPyramidLevel" }
        },
        "tileWidth": { "type": "number" },
        "tileHeight": { "type": "number" },
        "tiled": {
          "type": "boolean",
          "description": "Whether the data is internally tiled, as opposed to stripped."
        },
        "minZoom": {
          "type": "number",
          "description": "Tiled web services expose a zoom range rather than overview levels."
        },
        "maxZoom": { "type": "number" }
      }
    },
    "jGISVectorField": {
      "title": "IJGISVectorField",
      "description": "One column of a vector layer's attribute table.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" }
      }
    },
    "jGISVectorMetadata": {
      "title": "IJGISVectorMetadata",
      "description": "Information specific to vector data.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "featureCount": { "type": "number" },
        "geometryTypes": { "type": "array", "items": { "type": "string" } },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/jGISVectorField" }
        }
      }
    },
    "jGISMetadataFingerprint": {
      "title": "IJGISMetadataFingerprint",
      "description": "What the stored metadata was read from, so that it can be invalidated when the source changes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "version"],
      "properties": {
        "source": {
          "type": "string",
          "description": "The URL or path the metadata was read from. Metadata is recomputed when this no longer matches the source."
        },
        "version": {
          "type": "number",
          "description": "Version of the code that produced this metadata. Bump it to force existing documents to be re-read after the extractor improves."
        },
        "readAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of when the metadata was read."
        }
      }
    },
    "jGISSourceMetadata": {
      "title": "IJGISSourceMetadata",
      "description": "Facts read out of the source data itself: projection, extent, bands, pyramid and attribute schema. Written once when the source is added rather than re-read every time it is inspected, so that the notebook API and exporters can use it without a browser. Presentation-only rows (layer name, source type) are not stored here; they are derived from the document.",
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "crs": { "$ref": "#/definitions/jGISCrsMetadata" },
        "extent": { "$ref": "#/definitions/jGISExtentMetadata" },
        "bands": {
          "type": "array",
          "items": { "$ref": "#/definitions/jGISBandMetadata" }
        },
        "pyramid": { "$ref": "#/definitions/jGISPyramidMetadata" },
        "vector": { "$ref": "#/definitions/jGISVectorMetadata" },
        "extra": {
          "type": "array",
          "items": { "$ref": "#/definitions/jGISMetadataField" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Non-fatal caveats, e.g. that a band range was estimated rather than read. Stored alongside the values they qualify so that estimates are never presented as authoritative."
        },
        "fingerprint": { "$ref": "#/definitions/jGISMetadataFingerprint" }
      }
    }
  }
}
