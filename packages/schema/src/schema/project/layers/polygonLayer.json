{
  "type": "object",
  "description": "PolygonLayer",
  "title": "IPolygonLayer",
  "required": ["source"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "string",
      "description": "The id of the source"
    },
    "opacity": {
      "type": "number",
      "description": "The opacity of the layer",
      "default": 1,
      "multipleOf": 0.1,
      "minimum": 0,
      "maximum": 1
    },
    "filled": {
      "type": "boolean",
      "description": "Draw the polygon interior.",
      "default": true
    },
    "stroked": {
      "type": "boolean",
      "description": "Draw the polygon outline.",
      "default": true
    },
    "extruded": {
      "type": "boolean",
      "description": "Extrude the polygon using the elevation encoding. Prefer disabling extrusion over a constant elevation of 0.",
      "default": false
    },
    "symbologyState": {
      "type": "object",
      "description": "Grammar symbology for fill, stroke, line width, and elevation. Deck.gl accessors are derived at render time.",
      "additionalProperties": false,
      "required": ["layers"],
      "properties": {
        "layers": {
          "type": "array",
          "description": "Grammar rendering layers. Each layer is an independent rendering pipeline with optional preprocess transforms and encoding rules.",
          "items": {
            "$ref": "project/symbology.json#/definitions/IGrammarLayer"
          }
        }
      }
    }
  }
}
